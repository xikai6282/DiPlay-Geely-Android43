<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: the dashboard map as a card over the home screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Optional, owner-enabled Usage Access for the verified DiLink 5.1 cluster profile. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- The centre card also follows whichever launcher is the default home. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <application>
        <activity android:name="com.shilapi.xcertplay.DiPlayActivity"
            android:exported="true" android:launchMode="singleTop"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Xcertplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="com.shilapi.xcertplay.DiPlaySessionService"
            android:exported="false" android:foregroundServiceType="connectedDevice|microphone|location" />

        <activity
            android:name="com.shilapi.xcertplay.CarPlayHostActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <activity
            android:name="com.shilapi.xcertplay.CarPlayVideoActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enabled="@bool/carplay_video_player_enabled"
            android:exported="false"
            android:theme="@style/Theme.Xcertplay" />

        <activity
            android:name="com.shilapi.xcertplay.ImageCropActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay" />

        <!-- CarPlay navigation widget, for launchers that host standard widgets. -->
        <receiver
            android:name="com.shilapi.xcertplay.NavigationWidget"
            android:exported="false"
            android:label="@string/navigation_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/navigation_widget_info" />
        </receiver>

        <!-- The live dashboard map for launchers that embed it (docs/LAUNCHER_INTEGRATION.md). -->
        <service
            android:name="com.shilapi.xcertplay.MapEmbedService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.shihab.diplay.action.EMBED_MAP" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.shilapi.xcertplay.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
