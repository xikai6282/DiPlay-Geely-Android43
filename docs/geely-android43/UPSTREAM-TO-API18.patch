+        if (list != null) {
+            synchronized (list) {
+                ServiceListenerStatus status = new ServiceListenerStatus(listener, ListenerStatus.ASYNCHRONOUS);
+                list.remove(status);
+                if (list.isEmpty()) {
+                    _serviceListeners.remove(loType, list);
+                }
+            }
