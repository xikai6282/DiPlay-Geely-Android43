+    val blockingSupported: Boolean
+        get() = Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP
+
+    /** Nanoseconds to back off after an idle non-blocking read. */
+    const val WOULD_BLOCK_BACKOFF_NANOS = 2_000_000L
