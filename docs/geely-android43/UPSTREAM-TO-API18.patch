+        final StringBuilder sb = new StringBuilder(2048);
+        sb.append("\n");
+        sb.append("\t---- Local Host -----");
+        sb.append("\n\t");
+        sb.append(_localHost);
+        sb.append("\n\t---- Services -----");
+        for (final Map.Entry<String, ServiceInfo> entry : _services.entrySet()) {
