+    private void removeObsoleteDnsListener(ServiceEvent event) {
+        ServiceInfo serviceInfo = event.getInfo();
+        if (!(serviceInfo instanceof DNSListener)) {
+            return;
+        }
+        DNSListener listener = (DNSListener) serviceInfo;
+
+        removeListener(listener);
