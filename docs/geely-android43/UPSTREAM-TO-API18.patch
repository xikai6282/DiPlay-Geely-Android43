+     */
+    fun readNonBlocking(input: FileInputStream, buffer: ByteArray, running: () -> Boolean): Int {
+        if (!running()) return -1
+        val length = try {
+            input.read(buffer)
+        } catch (error: IOException) {
+            return if (isWouldBlock(error)) 0 else throw error
+        }
+        return if (length == -1) -1 else length
