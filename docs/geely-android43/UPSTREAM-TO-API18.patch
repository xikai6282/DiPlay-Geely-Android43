+            }
+        }
+
+        /**
+         * A new subtype for the service type was discovered.
+         * 
+         * <pre>
+         * &lt;sub&gt;._sub.&lt;app&gt;.&lt;protocol&gt;.&lt;servicedomain&gt;.&lt;parentdomain&gt;.
+         * </pre>
+         * 
