+        while (running()) {
+            val length = try {
+                input.read(buffer)
+            } catch (error: IOException) {
+                if (isWouldBlock(error)) {
+                    LockSupport.parkNanos(WOULD_BLOCK_BACKOFF_NANOS)
+                    continue
+                }
+                throw error
+            }
+            if (length == -1) return -1
+            if (length == 0) {
+                LockSupport.parkNanos(WOULD_BLOCK_BACKOFF_NANOS)
+                continue
+            }
+            return length
+        }
+        return -1
+    }
+
+    /**
